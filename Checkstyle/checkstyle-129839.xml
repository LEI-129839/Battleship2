<?xml version="1.0"?>
<!-- 129839 - Afonso Ribeiro : convenção para nomes de CONSTANTES (static final) -->
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="severity" value="error"/>
  <module name="TreeWalker">
    <module name="ConstantName">
      <!-- UPPER_SNAKE_CASE: maiúsculas e dígitos separados por _ (Google/Oracle Java Style) -->
      <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
      <message key="name.invalidPattern" value="A constante ''{0}'' tem de estar em UPPER_SNAKE_CASE (129839)."/>
    </module>
  </module>
</module>
