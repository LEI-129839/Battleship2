<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <module name="TreeWalker">
        <!-- Regra do teu colega -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern" value="O método ''{0}'' tem de ser camelCase."/>
        </module>

        <!-- A TUA REGRA CHECKSTYLE: TypeName (Nomes de Classes) -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern" value="A classe ''{0}'' tem de começar com letra maiúscula."/>
        </module>

        <!-- O TEU CODE SMELL: Large Class (Limite de métodos) -->
        <module name="MethodCount">
            <property name="maxTotal" value="30"/>
            <message key="too.many.methods" value="Large Class: A classe tem demasiados métodos."/>
        </module>
    </module>
</module>
